# Public storefront copy (optional). Vite only exposes vars prefixed with VITE_.
# Copy to `.env` / `.env.local` and adjust — do not commit real secrets.

# VITE_SITE_BRAND_NAME=SeaSide Live Bake Studio
# VITE_SITE_FOOTER_TITLE=SeaSide Live Bake Studio
# VITE_SITE_FOOTER_BULLETS=Fresh • Live • Delicious
# VITE_SITE_FOOTER_DESCRIPTION=Fresh • Live • Delicious. Your favorite restaurant delivering delicious meals right to your doorstep. Fresh ingredients, authentic flavors, and exceptional service.
# Split © line (bold first segment): set true for SeaSide-style footer
# VITE_SITE_COPYRIGHT_USE_SPLIT=true
# VITE_SITE_COPYRIGHT_BOLD=SeaSide
# VITE_SITE_COPYRIGHT_AFTER_BOLD=Live Bake Studio.
# VITE_FOOTER_LOGO_LIGHT=true

VITE_PUBLIC_PHONE_DISPLAY=+91 90000 00000
VITE_PUBLIC_PHONE_HREF=tel:+919000000000
VITE_PUBLIC_EMAIL=hello@zaanviorganics.com
# VITE_PUBLIC_EMAIL_HREF=mailto:hello@zaanviorganics.com
VITE_PUBLIC_ADDRESS=Hyderabad, Telangana, India

VITE_PUBLIC_FACEBOOK_URL=https://facebook.com
VITE_PUBLIC_INSTAGRAM_URL=https://instagram.com
VITE_PUBLIC_TWITTER_URL=https://twitter.com

# Fourth footer column heading (social links)
# VITE_SITE_SOCIAL_COLUMN_TITLE=Follow Us

# CTA banner (above footer) — optional overrides
# VITE_CTA_TITLE=Ready to Order?
# VITE_CTA_SUBTITLE=Join thousands of satisfied customers and experience the best food delivery service
# VITE_CTA_BUTTON_LABEL=Order Now
# VITE_CTA_BUTTON_PATH=/shop
